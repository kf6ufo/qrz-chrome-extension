{
  "manifest_version": 3,
  "name": "QRZ Callsign Extension",
  "version": "2.2.6",
  "description": "Right-click QRZ confirmation callsigns to sign Web Logs and view biographies, look up callsigns, or search your QRZ Logbook.",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["https://logbook.qrz.com/*", "https://www.qrz.com/*"],
  "content_scripts": [{
    "matches": ["https://forums.qrz.com/index.php*"],
    "js": ["notifications.js"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
